  "themes": [
    {
      "id": "paintbrush",
      "title": "失踪的画笔",
      "cover": "images/paintbrush/p01.webp",
      "pages": [
        {"img":"images/paintbrush/p01.webp","c":7,"r":7,"caption":"森林画室开门啦，小兔侦探阿绘摆好颜料、画笔和画布，准备迎接朋友们。"},
        {"img":"images/paintbrush/p02.webp","c":7,"r":7,"caption":"第二天清晨，一支画笔不见了，画架上的日出画却多了一道新鲜的颜色。"},
        {"img":"images/paintbrush/p03.webp","c":7,"r":8,"caption":"接连几天，画笔一支支消失，日出画却越画越美，阿绘决定查个明白。"},
        {"img":"images/paintbrush/p04.webp","c":7,"r":8,"caption":"傍晚，阿绘躲进画室守夜，发现彩色颜料脚印从画笔杯一直通向森林深处。"},
        {"img":"images/paintbrush/p05.webp","c":7,"r":9,"caption":"它循着颜料点来到老橡树下，树顶的猫头鹰小屋窗口正透出暖暖的光。"},
        {"img":"images/paintbrush/p06.webp","c":7,"r":9,"caption":"阿绘看见小松鼠抱着画笔上楼，可它神情焦急，一点也不像偷画笔的坏蛋。"},
        {"img":"images/paintbrush/p07.webp","c":8,"r":10,"caption":"原来小松鼠正用借来的画笔，为生病的老猫头鹰画一幅森林日出，想让它醒来先看到好风景。"},
        {"img":"images/paintbrush/p08.webp","c":8,"r":10,"caption":"阿绘终于明白真相，坐到小松鼠身边，一起陪着老猫头鹰把日出画完成。"},
        {"img":"images/paintbrush/p09.webp","c":8,"r":11,"caption":"阿绘和小松鼠并肩画上最后几笔，画布里的粉金色日出照亮了整个树屋。"},
        {"img":"images/paintbrush/p10.webp","c":8,"r":11,"caption":"老猫头鹰醒来，看见那幅画，眼睛里重新有了明亮的光。"},
        {"img":"images/paintbrush/p11.webp","c":8,"r":12,"caption":"画室从此成了森林共享画坊，小动物们都带着自己的颜色，一起画想画的风景。"},
        {"img":"images/paintbrush/p12.webp","c":9,"r":12,"caption":"金色清晨，阿绘放下放大镜，和朋友们一起画真正的森林日出——原来最好的线索，是关心。"}
      ]
    },
    {
      "id": "scarecrow",
      "title": "稻草人的神秘夜行",
      "cover": "images/scarecrow/p01.webp",
      "pages": [
        {"img":"images/scarecrow/p01.webp","c":7,"r":7,"caption":"麦田边的小镇，小狐狸阿察是个小侦探，它最爱在麦田边观察稻草人。"},
        {"img":"images/scarecrow/p02.webp","c":7,"r":7,"caption":"一天早晨，阿察发现稻草人的位置变了——昨天它还面朝东方，今天却面朝南方。"},
        {"img":"images/scarecrow/p03.webp","c":7,"r":8,"caption":"第二天，稻草人的草帽不见了，只剩光秃秃的脑袋。"},
        {"img":"images/scarecrow/p04.webp","c":7,"r":8,"caption":"夜里，阿察蹲在麦田边守了一夜，看见草帽在空中飘，还有小小的影子在动。"},
        {"img":"images/scarecrow/p05.webp","c":7,"r":9,"caption":"镇上的人都说稻草人闹鬼了，谁也不敢靠近麦田。"},
        {"img":"images/scarecrow/p06.webp","c":7,"r":9,"caption":"阿察不信，白天它爬上稻草人仔细检查，在帽檐下发现了几根小羽毛。"},
        {"img":"images/scarecrow/p07.webp","c":8,"r":10,"caption":"夜里，阿察终于看见：几只小麻雀衔着树枝，正飞进稻草人的帽子里。"},
        {"img":"images/scarecrow/p08.webp","c":8,"r":10,"caption":"原来不是闹鬼，是麻雀们在草帽里筑巢安家，搬树枝时把帽子顶得动来动去。"},
        {"img":"images/scarecrow/p09.webp","c":8,"r":11,"caption":"阿察爬上稻草人的手臂往里看——帽子里是暖暖的小窝，还躺着几颗蛋。"},
        {"img":"images/scarecrow/p10.webp","c":8,"r":11,"caption":"阿察没有惊动它们，悄悄退下来，还用麦秆帮它们挡住了风。"},
        {"img":"images/scarecrow/p11.webp","c":8,"r":12,"caption":"几天后，小鸟孵出来了，站在帽檐上叽叽喳喳，像戴了一顶会唱歌的帽子。"},
        {"img":"images/scarecrow/p12.webp","c":9,"r":12,"caption":"从此稻草人成了麦田的「小鸟公寓」，镇上的人都说：那不是鬼，是家。"}
      ]
    },
    {
      "id": "raccoon",
      "title": "小浣熊洗星星",
      "cover": "images/raccoon/p01.webp",
      "pages": [
        {"img":"images/raccoon/p01.webp","c":7,"r":7,"caption":"河边住着一只爱洗东西的小浣熊，它洗果子、洗石头，什么都想洗一洗。"},
        {"img":"images/raccoon/p02.webp","c":7,"r":7,"caption":"一天傍晚，阿浣发现河里有个东西一闪一闪，捞起来一看——是一颗小小的星星。"},
        {"img":"images/raccoon/p03.webp","c":7,"r":8,"caption":"阿浣以为星星脏了，把它放进水里仔细地洗，可星星越洗越亮。"},
        {"img":"images/raccoon/p04.webp","c":7,"r":8,"caption":"它把星星捞起来放在岸边，星星发出柔柔的光，阿浣开心得直转圈。"},
        {"img":"images/raccoon/p05.webp","c":7,"r":9,"caption":"夜里，河里又亮起好多光点，阿浣一颗颗捞起来，全都是小星星。"},
        {"img":"images/raccoon/p06.webp","c":7,"r":9,"caption":"阿浣抬头一看，天上的月亮缺了一块，像个被咬了一口的圆饼。"},
        {"img":"images/raccoon/p07.webp","c":8,"r":10,"caption":"原来这些星星是月亮掉下来的碎片，月亮一直在等它们回家。"},
        {"img":"images/raccoon/p08.webp","c":8,"r":10,"caption":"阿浣明白了，它把洗好的星星一颗颗小心地放回天上。"},
        {"img":"images/raccoon/p09.webp","c":8,"r":11,"caption":"星星自己飘向夜空，一颗颗重新镶回月亮缺掉的地方。"},
        {"img":"images/raccoon/p10.webp","c":8,"r":11,"caption":"月亮一点点变圆，阿浣和河边的小动物们仰着头看呆了。"},
        {"img":"images/raccoon/p11.webp","c":8,"r":12,"caption":"最后一颗星星放回去，月亮圆了，整条河都亮起星光的倒影。"},
        {"img":"images/raccoon/p12.webp","c":9,"r":12,"caption":"从此阿浣知道：星星本来就会发光，不用洗也亮；月亮每晚都朝它眨眼睛。"}
      ]
    },
    {
      "id": "hood",
      "title": "小红帽与点心篮",
      "cover": "images/hood/p01.webp",
      "pages": [
        {"img":"images/hood/p01.webp","c":7,"r":7,"caption":"清晨，小雅戴上红斗篷帽子，挎起满满一篮点心，要穿过森林去外婆家。"},
        {"img":"images/hood/p02.webp","c":7,"r":7,"caption":"森林里阳光透过树叶，小雅边走边摘野花，篮子里飘出甜甜的香味。"},
        {"img":"images/hood/p03.webp","c":7,"r":8,"caption":"她遇到小松鼠、小兔子、小鸟，分给它们几块点心，大家都开心极了。"},
        {"img":"images/hood/p04.webp","c":7,"r":8,"caption":"这时，一只「大灰狼」从树后跳出来，拦住了她，直盯着她的点心篮。"},
        {"img":"images/hood/p05.webp","c":7,"r":9,"caption":"小雅吓得抱紧篮子，一步步往后退，心想：外婆说的狼，真的来了。"},
        {"img":"images/hood/p06.webp","c":7,"r":9,"caption":"可「大灰狼」没有扑上来，它蹲下来，用爪子笨拙地比划着，好像在解释什么。"},
        {"img":"images/hood/p07.webp","c":8,"r":10,"caption":"原来那不是狼，是外婆家养的羊，戴着外婆织的狼形帽子，闻到点心香跑出来接她。"},
        {"img":"images/hood/p08.webp","c":8,"r":10,"caption":"羊摘下帽子，露出白白的卷毛，还顶了顶小雅的篮子，想帮她拿点心。"},
        {"img":"images/hood/p09.webp","c":8,"r":11,"caption":"小雅噗嗤一声笑了，和羊一起穿过森林，一路分点心给所有小动物。"},
        {"img":"images/hood/p10.webp","c":8,"r":11,"caption":"外婆家的烟囱正冒着烟，外婆站在门口招手，羊在前面蹦蹦跳跳地带路。"},
        {"img":"images/hood/p11.webp","c":8,"r":12,"caption":"外婆家开起点心会，羊戴着狼帽当「迎宾」，森林动物都来吃点心。"},
        {"img":"images/hood/p12.webp","c":9,"r":12,"caption":"黄昏，篮子里装满了大家回赠的花和果子，外婆说：明天，羊还会来接你。"}
      ]
    },
    {
      "id": "whale",
